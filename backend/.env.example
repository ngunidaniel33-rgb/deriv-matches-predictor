# Deriv API Configuration
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=your_deriv_app_id_here
DERIV_API_ENDPOINT=wss://ws.derivws.com/websockets/v3

# Analysis Settings
TICK_WINDOW_SIZE=1000
ANALYSIS_UPDATE_INTERVAL=1000
SIGNAL_CHECK_INTERVAL=5000
MIN_SAMPLE_SIZE=50
HIGH_CONFIDENCE_THRESHOLD=0.75
MEDIUM_CONFIDENCE_THRESHOLD=0.50
SIGNAL_PROBABILITY_THRESHOLD=0.12
ENABLE_STRONG_WATCH=true

# Weighting Factors
RECENT_WEIGHT=0.6
HISTORICAL_WEIGHT=0.4
MOMENTUM_WEIGHT=0.3

# Database
DATABASE_URL=sqlite:///./data.db
ENABLE_MIGRATIONS=true
POOL_SIZE=5
MAX_OVERFLOW=10

# Risk Management
ENABLE_BANKROLL_TRACKING=false
INITIAL_BANKROLL=1000.0
MAX_DAILY_LOSS=100.0
MAX_CONSECUTIVE_LOSSES=5
MAX_EXPOSURE_PERCENTAGE=5.0
TRADING_ENABLED=false
DEMO_MODE_ONLY=true
REQUIRE_MANUAL_CONFIRMATION=true

# UI Settings
UI_THEME=dark
DEFAULT_CHART_TYPE=line
ENABLE_SOUND_ALERTS=true
ENABLE_NOTIFICATIONS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
ENABLE_CONSOLE_LOGGING=true

# Application
APP_ENV=development
