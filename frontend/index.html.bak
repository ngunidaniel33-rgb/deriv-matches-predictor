<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Deriv Matches Predictor</title>
    <meta
      name="description"
      content="Professional Deriv matches and differs analysis dashboard for market signal review."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body class="theme-dark">
    <div class="app-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">Market intelligence</p>
          <h1>Deriv Matches Predictor</h1>
        </div>

        <div class="topbar-actions">
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
            <span class="toggle-icon">☀️</span>
            <span>Light</span>
          </button>
          <div class="status-pill">
            <span class="status-dot"></span>
            Live analysis
          </div>
        </div>
      </header>

      <section class="panel connect-panel">
        <div class="panel-header">
          <h2>Deriv account</h2>
          <div class="status-pill compact-pill">
            <span class="status-dot"></span>
            Disconnected
          </div>
        </div>

        <p class="muted">Connect your app ID and access token to authorize live market access.</p>

        <form id="deriv-form" class="connect-form">
          <div class="field-grid compact-grid">
            <label class="field">
              <span>Environment</span>
              <select id="environment">
                <option value="real">Real account</option>
                <option value="demo">Demo account</option>
              </select>
            </label>

            <label class="field">
              <span>App ID</span>
              <input id="app-id" type="text" placeholder="e.g. 1089 or your app ID" />
            </label>
          </div>

          <label class="field">
            <span>Access token</span>
            <input id="access-token" type="password" placeholder="Paste your Deriv access token" />
          </label>

          <button type="submit" class="primary-btn full-width">Connect account</button>
        </form>

        <div id="connection-status" class="status-box">Not connected yet.</div>
      </section>

      <main class="dashboard">
        <aside class="panel controls-panel">
          <div class="panel-header">
            <h2>Input data</h2>
            <button id="load-demo" class="secondary-btn">Load sample</button>
          </div>

          <div class="field-grid">
            <label class="field">
              <span>CSV file</span>
              <input id="file-input" type="file" accept=".csv,text/csv" />
            </label>

            <label class="field">
              <span>Analysis window</span>
              <input id="window-input" type="number" value="20" min="5" max="200" />
            </label>

            <label class="field">
              <span>Target digit</span>
              <select id="target-digit">
                <option value="">Auto detect</option>
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
              </select>
            </label>
          </div>

          <label class="field textarea-field">
            <span>Tick values</span>
            <textarea id="tick-input" rows="14" placeholder="Paste tick values or CSV data here...
Example:
1,2,3,4,5
or
tick
1
2
3"></textarea>
          </label>

          <div class="action-row">
            <button id="analyze-btn" class="primary-btn">Analyze market</button>
            <button id="clear-btn" class="ghost-btn">Clear</button>
          </div>
        </aside>

        <section class="panel summary-panel">
          <div class="panel-header">
            <h2>Market summary</h2>
            <span id="signal-badge" class="signal-badge neutral">Waiting</span>
          </div>

          <div class="metric-grid">
            <article class="metric-card accent">
              <span class="metric-label">Likely match digit</span>
              <strong id="likely-digit">--</strong>
              <small id="likely-probability">--</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Differ probability</span>
              <strong id="differ-probability">--</strong>
              <small>Opposing bias</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Signal strength</span>
              <strong id="signal-strength">--</strong>
              <small>Confidence score</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Average move</span>
              <strong id="average-move">--</strong>
              <small>Mean absolute delta</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Volatility</span>
              <strong id="volatility">--</strong>
              <small>Market swing</small>
            </article>

            <article class="metric-card">
              <span class="metric-label">Directional bias</span>
              <strong id="directional-bias">--</strong>
              <small id="directional-detail">Up vs down</small>
            </article>
          </div>

          <div class="insight-box">
            <h3>Recommendation</h3>
            <p id="recommendation">Waiting for market data to analyze.</p>
          </div>
        </section>

        <section class="panel chart-panel">
          <div class="panel-header">
            <h2>Tick sequence</h2>
          </div>
          <div class="chart-wrap">
            <canvas id="tick-chart" height="150"></canvas>
          </div>
        </section>

        <section class="panel distribution-panel">
          <div class="panel-header">
            <h2>Digit distribution</h2>
          </div>
          <div class="chart-wrap">
            <canvas id="distribution-chart" height="150"></canvas>
          </div>
        </section>
      </main>
    </div>

    <script src="app.js"></script>
  </body>
</html>
